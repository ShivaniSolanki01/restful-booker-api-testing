    {
      "name": "03 - Create Booking",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Booking creation returns 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Response contains a booking ID\", function () {\r\n    const data = pm.response.json();\r\n    pm.expect(data).to.have.property(\"bookingid\");\r\n    pm.expect(data.bookingid).to.be.a(\"number\");\r\n\r\n    pm.collectionVariables.set(\"bookingId\", data.bookingid);\r\n});\r\n\r\npm.test(\"Booking details match the request\", function () {\r\n    const data = pm.response.json().booking;\r\n\r\n    pm.expect(data.firstname).to.eql(\"Shivani\");\r\n    pm.expect(data.lastname).to.eql(\"TestUser\");\r\n    pm.expect(data.totalprice).to.eql(150);\r\n    pm.expect(data.depositpaid).to.eql(true);\r\n    pm.expect(data.additionalneeds).to.eql(\"Breakfast\");\r\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"firstname\": \"Shivani\",\r\n  \"lastname\": \"TestUser\",\r\n  \"totalprice\": 150,\r\n  \"depositpaid\": true,\r\n  \"bookingdates\": {\r\n    \"checkin\": \"2027-01-10\",\r\n    \"checkout\": \"2027-01-15\"\r\n  },\r\n  \"additionalneeds\": \"Breakfast\"\r\n}",
          "options": {
