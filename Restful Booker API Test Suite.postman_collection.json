    {
      "name": "01 - API Health Check",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"API health check returns 201\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\npm.test(\"Response body is Created\", function () {\r\n    pm.expect(pm.response.text()).to.eql(\"Created\");\r\n});"
            ]
          }
        }
