    {
      "name": "04 - Get Booking by ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Get booking returns 200\", function () {\n    pm.response.to.have.status(200);\n});\n\npm.test(\"Booking has the expected details\", function () {\n    const data = pm.response.json();\n\n    pm.expect(data.firstname).to.eql(\"Shivani\");\n    pm.expect(data.lastname).to.eql(\"TestUser\");\n    pm.expect(data.totalprice).to.eql(150);\n    pm.expect(data.bookingdates.checkin).to.eql(\"2027-01-10\");\n    pm.expect(data.bookingdates.checkout).to.eql(\"2027-01-15\");\n});\n\npm.test(\"Booking response contains required fields\", function () {\n    const data = pm.response.json();\n\n    pm.expect(data).to.have.property(\"firstname\");\n    pm.expect(data).to.have.property(\"lastname\");\n    pm.expect(data).to.have.property(\"bookingdates\");\n});"
            ]
          }
        }
      ],
